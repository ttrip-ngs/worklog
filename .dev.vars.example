# cp .dev.vars.example .dev.vars して使う。ローカルの擬似ログイン用。
# 本番(wrangler deploy)では設定しないこと。未設定なら API は 401 を返す。
DEV_AUTH_EMAIL=you@example.com
DEV_AUTH_NAME=開発ユーザー

# wrangler.jsonc の vars にある本番の Cloudflare Access 設定を、ローカルでは打ち消す。
# (.dev.vars は vars より優先される。空にしないとローカルでも Access の JWT を要求され、
#  ログインできず 401 になる)
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
