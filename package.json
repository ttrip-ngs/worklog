{
  "name": "worklog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "db:init": "wrangler d1 execute worklog-db --local --file=./db/schema.sql",
    "db:seed": "wrangler d1 execute worklog-db --local --file=./db/seed.sql",
    "db:reset": "npm run db:init && npm run db:seed"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "hono": "^4.13.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.125.0",
    "@cloudflare/workers-types": "^5.20260823.1"
  }
}
