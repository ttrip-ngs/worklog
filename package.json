{
  "name": "worklog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "db:init": "wrangler d1 execute worklog-db --local --file=./db/schema.sql",
    "db:seed": "wrangler d1 execute worklog-db --local --file=./db/seed.sql",
    "db:reset": "npm run db:init && npm run db:seed",
    "db:init:remote": "wrangler d1 execute worklog-db --remote --file=./db/schema.sql",
    "db:migrate": "wrangler d1 execute worklog-db --local --file=./db/migrations/0001_report_meta_lock.sql",
    "db:migrate:remote": "wrangler d1 execute worklog-db --remote --file=./db/migrations/0001_report_meta_lock.sql"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
